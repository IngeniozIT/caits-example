<const/theme=themeOf($global.request)>

<!doctype html>
<html lang="en" data-theme=theme>
  <head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1"/>
    <title>${titles[$global.route] ?? "CAITS"}</title>
    <link rel="icon" type="image/svg+xml" href=icon/>
  </head>
  <body>
    <header>
      <a href="/"><Logo/><span>CAITS</span></a>
      <nav aria-label="Main menu">
        <a href="/" aria-current=($global.route === "/" && "page")>Home</a>
        <a href="/messages" aria-current=($global.route === "/messages" && "page")>Example</a>
      </nav>
      <ThemeSwitch theme=theme/>
    </header>
    <${input.content}/>
  </body>
</html>
