  <path class="key" d="M37.32 15.78L40.44 15.01L43.60 14.45L46.79 14.11L50 14L53.21 14.11L56.40 14.45L59.56 15.01L62.68 15.78L54 46.06L52.02 45.64L50 45.50L47.98 45.64L46 46.06Z"/>
