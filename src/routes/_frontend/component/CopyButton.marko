import { copy, textToCopy } from "#frontend/site/presentation/component/clipboard/clipboard.js";
import "./CopyButton.scss";

// The button that copies the text of an element of the page (target: its id), with its spaces collapsed: a command, or a prompt. Its
// label names what it copies. Then it says "Copied", or "Copy failed", for two seconds, also to a screen reader. The copy is in the
// context site (presentation/component/clipboard/), with its test.

export interface Input {
  target: string;
  label: string;
}

<let/result=undefined as "Copied" | "Copy failed" | undefined>
<let/timer=undefined as ReturnType<typeof setTimeout> | undefined>

<button type="button" class="copy-button" aria-label=(result ?? input.label) onClick() {
  void copy(textToCopy(document.getElementById(input.target)?.textContent ?? ""), navigator.clipboard).then(copied => {
    // A second click starts the two seconds again.
    clearTimeout(timer);
    result = copied ? "Copied" : "Copy failed";
    timer = setTimeout(() => { result = undefined; }, 2000);
  });
}>
  <span aria-live="polite">${result ?? "Copy"}</span>
</button>
